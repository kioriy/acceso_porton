# ── Servidor HTTP ──────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8765
# Clave opcional para autenticar la app QR (header X-Api-Key)
API_SECRET=

# ── TLS (HTTPS) ─────────────────────────────────────────────────────────────
# Generados por mkcert (ejecuta setup_windows.bat para crearlos automaticamente)
#   mkcert -install
#   mkcert localhost 127.0.0.1
SSL_CERTFILE=localhost+1.pem
SSL_KEYFILE=localhost+1-key.pem

# ── Rele DSD TECH SH-UR01A ─────────────────────────────────────────────────
# Modo de comunicacion: "hid" (USB-HID) o "serial" (CH340/CP2102)
# En Windows el modo HID es el mas comun para este rele.
RELAY_MODE=hid

# HID — valores por defecto del protocolo USB-relay generico
RELAY_HID_VID=0x16C0
RELAY_HID_PID=0x05DF

# Serial — en Windows el puerto es COMx (ver Administrador de dispositivos)
# Ejemplo: COM3, COM4, COM5
# Dejar vacio si usas modo HID
RELAY_SERIAL_PORT=
RELAY_SERIAL_BAUD=9600

# Duracion del pulso de apertura en segundos
RELAY_PULSE_SECONDS=1.0

# Canal del rele (el SH-UR01A tiene 1 canal)
RELAY_CHANNEL=1
