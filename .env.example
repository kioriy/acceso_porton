# ── Servidor HTTP ──────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8765
# Clave opcional para autenticar la app QR (header X-Api-Key)
API_SECRET=

# ── TLS (HTTPS) ─────────────────────────────────────────────────────────────
# Dejar vacío para HTTP. Si usas mkcert, pon los archivos generados:
#   mkcert -install
#   mkcert localhost 127.0.0.1
SSL_CERTFILE=localhost+1.pem
SSL_KEYFILE=localhost+1-key.pem

# ── Relé DSD TECH SH-UR01A ─────────────────────────────────────────────────
# Modo de comunicación: "hid" (USB-HID) o "serial" (CH340/CP2102)
RELAY_MODE=hid

# HID — valores por defecto del protocolo USB-relay genérico
RELAY_HID_VID=0x16C0
RELAY_HID_PID=0x05DF

# Serial — ejemplo macOS: /dev/tty.usbserial-XXXX
#          ejemplo Linux: /dev/ttyUSB0
RELAY_SERIAL_PORT=
RELAY_SERIAL_BAUD=9600

# Duración del pulso de apertura en segundos
RELAY_PULSE_SECONDS=1.0

# Canal del relé (el SH-UR01A tiene 1 canal)
RELAY_CHANNEL=1
